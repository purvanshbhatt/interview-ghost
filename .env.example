# ==============================================================================
# GHOST — Autonomous Stealth AI Interview & Meeting Copilot
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your credentials.
# All keys and settings can also be managed directly within the Ghost UI Settings.

# ------------------------------------------------------------------------------
# 1. Primary AI Provider Credentials (At least one required)
# ------------------------------------------------------------------------------

# Google Gemini (Recommended for low latency and high accuracy)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_SMART_MODEL=gemini-2.5-pro

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_SMART_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-latest
ANTHROPIC_SMART_MODEL=claude-3-5-sonnet-latest

# Groq (Ultra-fast cloud Llama inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# MiniMax
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here
MINIMAX_FAST_MODEL=MiniMax-M2.7
MINIMAX_SMART_MODEL=MiniMax-M3

# Azure OpenAI / AI Foundry
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_FAST_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_SMART_DEPLOYMENT=gpt-4o

# Ollama (Local AI Server)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_FAST_MODEL=llama3.2
OLLAMA_SMART_MODEL=llama3.3

# Custom OpenAI-Compatible Endpoints (vLLM, LocalAI, OpenClaw, OpenRouter)
CUSTOM_LLM_BASE_URL=http://127.0.0.1:8000/v1
CUSTOM_LLM_API_KEY=optional_custom_api_key
CUSTOM_LLM_MODEL=custom-model-id
CUSTOM_LLM_FAST_MODEL=custom-fast-model
CUSTOM_LLM_SMART_MODEL=custom-smart-model

# ------------------------------------------------------------------------------
# 2. Speech-to-Text (STT) Services
# ------------------------------------------------------------------------------

# Deepgram (Real-time live streaming audio transcription)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2

# Whisper (Local whisper.cpp sidecar or remote whisper-server)
LOCAL_WHISPER_ENABLED=true
WHISPER_URL=http://127.0.0.1:8080/inference
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en

# ------------------------------------------------------------------------------
# 3. Application & Stealth Toggles
# ------------------------------------------------------------------------------

# Default Provider to load on startup (gemini, openai, anthropic, groq, ollama, minimax, azure, custom)
DEFAULT_PROVIDER=gemini

# Default Reasoning Tier (false = Fast tier, true = Smart tier)
SMART_MODE=false

# Stealth Screen Share Protection (true = exclude window from Zoom/Meet/Teams)
ENABLE_STEALTH_MODE=true

# Save transcript logs and session summaries to disk
SAVE_TRANSCRIPTS=true

# Node & Debug Options
NODE_ENV=development
PORT=3000
DEBUG=false
